# Reservon Accounts — build-time configuration.
#
# Vite inlines VITE_* at build time, so this file must be present in the Docker
# build context (the Jenkins pipeline writes it from the credential). There is no
# runtime environment for a static bundle: changing any of these needs a rebuild.

# The Reservon platform API (reservon_backend). Every request this app makes goes
# here, with credentials, so it must be same-site with this app in production for
# the session cookie to travel — account.reservonhq.com and api.reservonhq.com both
# are. Same variable name as the other Reservon front-ends. Defaults to production.
VITE_PLATFORM_API_URL=https://api.reservonhq.com

# Hosts a `?next=` may return to, comma-separated. Subdomains are included
# automatically. Anything not listed is ignored rather than followed: an open
# redirect on a sign-in page is a phishing primitive, so this list is a security
# control, not a convenience.
VITE_ALLOWED_RETURN_HOSTS=reservonhq.com

# The marketing site, for the Terms and Privacy links on the signup screen.
VITE_WEBSITE_URL=https://reservonhq.com
